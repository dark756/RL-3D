# =====================================================================================================
#  Mars Lander RL - every physical fact and simulation setting the code uses, one per line.
#
#  Format:    KEY=value          # unit | status | source | note
#    status   published = printed in a source (page / figure / table given in `source`)
#             derived   = computed from published numbers (how is in `note`)
#             assumed   = our estimate or design choice - verify or change it
#    Lists are comma-separated (one value per engine / leg / ...).
#    lander/config.py refuses to start if a line is missing, unknown, or has no status/source.
#    docs/env_variables.md explains every variable and why it is kept.
#
#  Change a value: edit it here, or override without editing:
#    PowerShell:  $env:LANDER_VIKING_ENGINE_T90_S = "0.1"    (env var  LANDER_<KEY>)
#    any script:  --set VIKING_ENGINE_T90_S=0.1              (CLI)
#  Overrides are marked status "override" and recorded in every episode log.
#  This file holds no secrets; keep it that way (VS Code also loads .env into the environment).
#
#  Geometry frame (same as NASA TN D-7959, S4 Fig 3): origin on the lander's centre line at the
#  footpad contact plane, +Z up the thrust axis, leg 1 on +Y, azimuths measured from +X toward +Y.
#  Simplified vehicle (brief D15): rigid legs, CG fixed on the centre line, no roll jets.
#
#  Sources (local copies of S3/S4/S5: python -m scripts.fetch_sources -> docs/sources/)
#   S2  Viking 1 Lander (NASA NSSDCA) ............ https://nssdc.gsfc.nasa.gov/nmc/spacecraft/display.action?id=1975-075C
#   S3  NASA RP-1027 Viking '75 design & test .... https://ntrs.nasa.gov/api/citations/19810001592/downloads/19810001592.pdf
#   S4  NASA TN D-7959 touchdown Monte Carlo ..... https://ntrs.nasa.gov/api/citations/19750023452/downloads/19750023452.pdf
#   S5  Pohlen et al., Viking landing gear ....... https://ntrs.nasa.gov/api/citations/19760021205/downloads/19760021205.pdf
#   S7  Dawson et al., MSL throttling engine ..... AIAA 2007-5481
#   S8  Viking engine cutaway, 18-nozzle loss .... https://www.researchgate.net/figure/king-Lander-Engine-Cutaway-View-Rocket-Research-Primex-Aerospace_fig4_232617757
#   S9  Aerojet Mars lander propulsion ........... IAC-10.C4.1.7
#   S11 NASA Mars fact sheet ..................... https://nssdc.gsfc.nasa.gov/planetary/factsheet/marsfact.html
#   design brief (numerical choices made in the design discussion)
#   M3  tuned on the M3 evaluation runs (docs/env_variables.md, "The classical controller")
#   M4  set for the M4 training (docs/env_variables.md, "Training the agent")
#  Page numbers ("p96") are PDF page numbers of the local copies.
# =====================================================================================================

# ---------------------------------------------------------------- terminal descent engines -----------
VIKING_ENGINE_THRUST_MIN_N=276            # N | published | S2,S9 | per engine at valve setting 0 (10:1 throttle); only the engines-off command gives zero thrust
VIKING_ENGINE_THRUST_MAX_N=2667           # N | published | S2,S9 | per engine at valve setting 1; S3's blowdown thrust decay not modelled (D13)
VIKING_ENGINE_ISP_S=195                   # s | derived | S7,S8 | MSL engine measured 204-223 s, minus ~9% loss of Viking's 18-nozzle design
VIKING_ENGINE_X_M=0.835,-0.835,0.0        # m | published | S4 Fig 6a | engines 1,2,3; measured from the centre line
VIKING_ENGINE_Y_M=0.482,0.482,-0.989      # m | published | S4 Fig 6a | S3 Fig 74 (as flown) lists 0.836 / 0.483 / 0.965 m
VIKING_ENGINE_T90_S=0.053                 # s | derived | S4 Fig 6b,S7 | time to 90 % of any thrust change: Viking's shutdown tail-off digitised as first order (tau ~23 ms); used for throttle-up too (assumed; MSL valve 50 ms, S7)
VIKING_ENGINE_MISALIGN_DEG=0.044          # deg | assumed | S7 | thrust-axis error, random direction each episode; proxy: MSL engine measured value (Viking spec +-1.0 deg geometric, S3 p97)

# ---------------------------------------------------------------- mass and inertia -------------------
VIKING_MASS_DRY_KG=573.1                  # kg | derived | S2,S3 p141 | 657 kg at engine ignition (S2) minus 83.9 kg terminal-descent propellant (S3); mass = dry + propellant left
VIKING_MASS_START_PROPELLANT_KG=60        # kg | assumed | - | propellant at the start of an episode (200-500 m up); M3's classical controller used 40 kg median, 53 kg at most on 1,000 test episodes, ~54 kg from the hardest start
VIKING_MASS_IXX_KGM2=162.7                # kg*m2 | published | S4 Fig 3 | principal, about body axes through the CG, at touchdown mass (120 slug*ft2); held constant
VIKING_MASS_IYY_KGM2=216.9                # kg*m2 | published | S4 Fig 3 | (160 slug*ft2)
VIKING_MASS_IZZ_KGM2=298.3                # kg*m2 | published | S4 Fig 3 | (220 slug*ft2)
VIKING_MASS_CG_Z_M=0.7904                 # m | published | S4 Fig 3 | CG height above the footpad plane (= 0.566 x footpad radius, S4 p5); CG on the centre line (D15)

# ---------------------------------------------------------------- landing legs (rigid) --------------
VIKING_LEG_AZIMUTH_DEG=90,-30,210         # deg | published | S4 Fig 3 | legs 1,2,3
VIKING_LEG_FOOTPAD_RADIUS_M=1.397         # m | published | S4 Fig 3,S5 Fig 8 | 55.00 in from the centre line
VIKING_LEG_FOOTPAD_Z_M=0.03175            # m | published | S4 Fig 3,S5 Fig 8 | footpad junction above the contact plane (1.25 in) = contact sphere radius

# ---------------------------------------------------------------- aerodynamics ----------------------
VIKING_AERO_CDA_M2=2.01                   # m2 | derived | S4 Table II,S3 p98,S11 | drag coefficient x area, the same in every direction; calibrated: S4's 3-sigma lateral aero force 57.58 N at the 99 % design wind 51 m/s (S3 p98) in 0.022 kg/m3 air (S11: 0.016 + 0.006). Was the lateral value; the separate axial 1.80 m2 was cut 2026-10-10 (using 2.01 adds ~1.5 N at 30 m/s)

# ---------------------------------------------------------------- radars (altimeter + Doppler) ------
VIKING_RADAR_PERIOD_S=0.2                 # s | published | S3 p93 | both radars sampled every 200 ms (sample-and-hold); antennas at the centre of the underside
VIKING_RADAR_ALT_MIN_RANGE_M=41           # m | published | S3 p103,p109 | altimeter readings below 41 m were ignored (false lock on lander structure)
VIKING_RADAR_ALT_ERR_FRAC=0.045           # - | published | S3 p109 | accuracy 4.5 % + 1.5 m; treated as 3 sigma (assumed)
VIKING_RADAR_ALT_ERR_M=1.5                # m | published | S3 p109 |
VIKING_RADAR_DOPPLER_SPLAY_DEG=21.5       # deg | published | S3 p112 | each of the 4 beams is 21.5 deg from the -Z axis, in the X-Z and Y-Z planes (Viking's 45 deg rotation about Z, S3 Fig 60, cut 2026-10-10)
VIKING_RADAR_DOPPLER_MIN_SPEED_MPS=1      # m/s | published | S3 p112 | a beam needs >= 1 m/s closing speed to lock; any 3 locked beams give the velocity
VIKING_RADAR_DOPPLER_ERR_FRAC=0.015       # - | published | S3 p112 | accuracy 1.5 % or 0.3 m/s, whichever is greater; treated as 3 sigma (assumed)
VIKING_RADAR_DOPPLER_ERR_MPS=0.3          # m/s | published | S3 p112 |

# ---------------------------------------------------------------- landing requirements (brief section 7)
VIKING_REQ_VERTICAL_SPEED_MPS=3.34        # m/s | derived | S5 Table 1 | 2.44 + 0.9 m/s; a faster first contact breaks a leg
VIKING_REQ_HORIZONTAL_SPEED_MPS=1.22      # m/s | published | S5 Table 1 | a faster first contact breaks a leg
VIKING_REQ_SETTLE_KE_FRAC=0.005           # - | published | S4 p9 | settled when kinetic energy < 0.5 % of impact KE
VIKING_REQ_TILT_DEG=5                     # deg | published | S3 Table 8 | touchdown attitude 0 +- 5 deg: tilt at first contact (O3, used since 2026-10-10)
VIKING_REQ_RATE_PITCHYAW_DPS=7            # deg/s | published | S3 Table 8 | pitch/yaw rate at first contact; spin is not limited (no roll control, D4)

# ---------------------------------------------------------------- Viking's final-phase guidance (M3) --
VIKING_SEQ_TERMINAL_SPEED_MPS=2.44        # m/s | published | S3 p104 | constant-velocity final descent, held down to touchdown
VIKING_SEQ_TERMINAL_ALT_M=16.8            # m | published | S3 p104 | the constant-velocity phase starts at this altitude (brief / S10: ~12 m)
VIKING_SEQ_AXIAL_THROTTLE_LIMIT=0.84      # - | published | S3 p99 | average valve setting the descent-speed loop may command; the travel above it is kept for attitude control

# ---------------------------------------------------------------- Mars ------------------------------
MARS_GRAVITY_MPS2=3.71                    # m/s2 | published | S11 | mean surface gravity (equatorial 3.69); S3 p13 design value 3.7
MARS_AIR_DENSITY_KGPM3=0.016              # kg/m3 | published | S11 | surface value, used at every height (it changes < 5 % over 500 m)
MARS_WIND_STORM_MPS=17,30                 # m/s | published | S11 | dust-storm wind range; calm episodes have no wind (2-10 m/s moves the lander < 0.08 m/s in 30 s)

MARS_TERRAIN_SLOPE_DEG=0                  # deg | assumed | - | ground when a reset gives none (scenarios, tests); the training env samples it
MARS_TERRAIN_SLOPE_DIRECTION_DEG=0        # deg | assumed | - | downhill direction, from +X toward +Y
MARS_TERRAIN_FRICTION=0.6                 # - | assumed | S4,S5 | footpad friction when a reset gives none: middle of the published 0.2-1.0 range
MARS_TERRAIN_SLOPE_P90_DEG=11.7           # deg | published | S4 p15,Table II | training env: slopes exponential, 90 % below 11.7 deg, downhill direction uniform
MARS_TERRAIN_SLOPE_MAX_DEG=19             # deg | assumed | S5 Table 1 | training env: sampled slopes stop here (Viking's early gear requirement: stable on all 19 deg slopes); steeper ground is for the fuzzing study
MARS_TERRAIN_FRICTION_RANGE=0.2,1.0       # - | published | S4 p8,S5 Table 1 | training env: friction uniform in this range (0.2 critical for clearance, 1.0 for stability), from HOLD_RATIO x tan(slope) up
MARS_TERRAIN_HOLD_RATIO=1.25              # - | assumed | M3 | training env: friction is drawn from [max(0.2, this x tan(slope)), 1.0] so a lander at rest holds on the slope (D26); below ~1.25 a 2.44 m/s touchdown slid for more than 5 s

# ---------------------------------------------------------------- simulation numerics ---------------
SIM_PHYSICS_DT_S=0.002                    # s | assumed | brief | physics step; brief section 6: <= 2 ms
SIM_CONTROL_HZ=25                         # Hz | assumed | brief,S3 p105 | 40 ms zero-order hold = Viking navigator / outer-loop period
SIM_CONTACT_TIMECONST_S=0.01              # s | assumed | - | MuJoCo soft-contact time constant; with rigid legs it shapes the impact. Was 0.005 until 2026-10-10 (D27): at 2.5 physics steps a lander at rest could micro-bounce and never count as settled
SIM_SENSOR_NOISE_SCALE=1.0                # - | assumed | brief | 1 = Viking's published radar errors (decided 2026-10-05); 0 = perfect readings (tests)

# ---------------------------------------------------------------- training episode (M2, 2026-10-10) -
# Read by envs/mars_lander_env.py (brief D19, D20). The start height is the user's decision (D16); the
# rest were set at the user's request. Ranges are "low,high" and sampled uniformly.
EPISODE_START_HEIGHT_M=200,500            # m | assumed | brief | lowest footpad above the ground below it (D16)
EPISODE_START_OFFSET_M=0,50               # m | assumed | brief | horizontal distance from the target, in a random direction
EPISODE_START_DESCENT_MPS=10,30           # m/s | assumed | brief | downward speed
EPISODE_START_SIDEWAYS_MPS=0,10           # m/s | assumed | brief | horizontal speed, in a random direction
EPISODE_START_TILT_DEG=0,15               # deg | assumed | brief | thrust axis from vertical, leaning a random way; the heading is random too
EPISODE_START_RATE_DPS=2                  # deg/s | assumed | brief | each body rate uniform in +-2 deg/s
EPISODE_STORM_FRACTION=0.3                # - | assumed | brief | share of episodes with a dust storm (D17); the rest are calm
EPISODE_ZONES_M=5,20,200                  # m | assumed | brief | distance from the target: green zone, pad (a success must settle inside it), arena (leaving it ends the episode)
EPISODE_CEILING_M=600                     # m | assumed | brief | climbing above this height (lowest footpad above the ground) ends the episode
EPISODE_TIME_LIMIT_S=100                  # s | assumed | brief | no touchdown by then ends the episode (the 60 kg tank allows ~49 s of hover)
EPISODE_TILT_LIMIT_DEG=45                 # deg | assumed | brief | tilting further in flight ends the episode (lost attitude)
EPISODE_SETTLE_WINDOW_S=5                 # s | assumed | brief | time after the first contact to cut the engines and settle

# ---------------------------------------------------------------- reward (M2, 2026-10-10) -----------
# Paid once, when the episode ends (brief D21); set at the user's request, following the user's
# ideas (green and yellow zones, a time cost, a tilt cost). A safe landing always scores more than any failure.
REWARD_LANDING=100,80,30                  # pts | assumed | brief | safe landing at the edge of the green zone, the pad, the arena (EPISODE_ZONES_M); 100 inside the green zone, linear in between
REWARD_TIME_PER_S=0.2                     # pts/s | assumed | brief | taken off a landing for every second of the episode
REWARD_TILT_FREE_DEG=20                   # deg | assumed | brief | peak tilt in flight that costs nothing
REWARD_TILT_PER_DEG=0.4                   # pts/deg | assumed | brief | taken off a landing per degree of peak tilt above REWARD_TILT_FREE_DEG
REWARD_FAILURE=-100,-50                   # pts | assumed | brief | a failure in flight or a hard crash; a failure at touchdown within the leg speed limits
REWARD_CRASH_RATIO=6                      # - | assumed | brief | touchdown failures go linearly from -50 at the leg speed limits to -100 at this multiple of them (6 x 3.34 = 20 m/s down)

# ---------------------------------------------------------------- classical controller (M3, 2026-10-10)
# Read by controllers/classical.py only (brief D24); they never change the simulation or the agent. Set by
# The structure follows Viking's guidance (S3 p96-104), the numbers were tuned on M3 evaluation runs.
CTRL_BRAKE_MPS2=4.5                       # m/s2 | assumed | M3 | deceleration of the speed-height contour that ends at the gate (TERMINAL_ALT_M, TERMINAL_SPEED_MPS); the axial limit allows ~7
CTRL_DESCENT_GAIN_PER_S=2                 # 1/s | assumed | M3 | descent-speed error -> vertical acceleration command
CTRL_POSITION_GAIN_PER_S=0.2              # 1/s | assumed | M3 | distance from the target -> sideways speed command (above the gate only)
CTRL_SIDE_SPEED_MPS=8                     # m/s | assumed | M3 | largest sideways speed command
CTRL_SIDE_GAIN_PER_S=0.5                  # 1/s | assumed | M3 | sideways speed error -> sideways acceleration command
CTRL_SIDE_ACCEL_MPS2=2.5                  # m/s2 | assumed | M3 | sideways acceleration assumed when budgeting time for the move to the target (the descent waits for it)
CTRL_SIDE_SETTLE_S=1                      # s | assumed | M3 | extra time in that budget
CTRL_TILT_MAX_DEG=20,3                    # deg | assumed | M3 | largest tilt command above the gate; at the ground, linear in between (S3 Table 8 allows 5 at touchdown)
CTRL_TILT_RATE_DPS=20,3                   # deg/s | assumed | M3,S3 p98 | how fast the tilt command may change above / below the gate (Viking limited its pitch/yaw errors to 30 deg/s)
CTRL_ATTITUDE_RADPS=4                     # rad/s | assumed | M3 | natural frequency of the attitude loop (differential throttle)
CTRL_ATTITUDE_DAMPING=0.8                 # - | assumed | M3 | damping ratio of the attitude loop
CTRL_FUEL_MARGIN=0.2                      # - | assumed | M3 | stop steering for the target once the propellant left is under (1 + this) x what a straight-down landing from here needs

# ---------------------------------------------------------------- training curriculum (M4, 2026-10-11) -
# Read by envs/mars_lander_env.py and scripts/train.py (brief D23; the user chose to scale the whole start
# together, D29). Level 0 draws the start from these ranges, level 1 from EPISODE_START_* (D19); every range end
# moves by the same factor per level (GEOMETRIC). Weather, slope and friction are drawn as in D17/D19 at every
# level. The test sets and the validation runs always use level 1. Values from the 2026-10-11 pilots
# (docs/env_variables.md, "Pilot runs").
CURRICULUM_START_HEIGHT_M=5,15            # m | assumed | M4 | lowest footpad above the ground at level 0; from 20-50 m an untrained agent learned to hover instead of land (pilots)
CURRICULUM_START_OFFSET_M=0,5             # m | assumed | M4 | distance from the target at level 0
CURRICULUM_START_DESCENT_MPS=1,3          # m/s | assumed | M4 | downward speed at level 0, within the 3.34 m/s leg limit
CURRICULUM_START_SIDEWAYS_MPS=0,1         # m/s | assumed | M4 | horizontal speed at level 0
CURRICULUM_START_TILT_DEG=0,3             # deg | assumed | M4 | tilt at level 0
CURRICULUM_START_RATE_DPS=0.5             # deg/s | assumed | M4 | each body rate uniform in +-this at level 0
CURRICULUM_STEP=0.1                       # - | assumed | M4 | how much the level rises at a time (10 steps from 0 to 1)
CURRICULUM_PROMOTE_SUCCESS=0.7            # - | assumed | M4 | success rate over the last WINDOW_EPISODES episodes started at the current level that raises it
CURRICULUM_WINDOW_EPISODES=200            # - | assumed | M4 | episodes judged; at 70 % success the 95 % interval is +-6 %
CURRICULUM_GEOMETRIC=1                    # - | assumed | M4 | 1 = every level multiplies each range end by the same factor (x1.42 for the top height); 0 = adds the same amount, which made the first step 4x and collapsed the pilots
CURRICULUM_MIX=0.5                        # - | assumed | M4 | share of training episodes that start at a random level below the current one (keeps easy landings coming; promoted faster and hovered less in the pilots)

# ---------------------------------------------------------------- PPO agent (M4, 2026-10-11) ----------
# Read by scripts/train.py (brief D9, D23). Set by the assistant; Stable-Baselines3 defaults are kept for everything
# not listed (entropy bonus 0, advantage normalisation on, VecNormalize reward scaling and clipping at 10).
PPO_GAMMA=0.999                           # - | assumed | M4 | discount per 40 ms control step: a horizon of ~1,000 steps (40 s), about one landing from 500 m
PPO_GAE_LAMBDA=0.95                       # - | assumed | M4 | advantage estimation (SB3 default)
PPO_LEARNING_RATE=0.0003                  # - | assumed | M4 | Adam step size, constant so a run can resume (SB3 default)
PPO_STEPS_PER_UPDATE=8192                 # steps | assumed | M4 | experience per update, over all of one seed's envs (~10 landings from full height)
PPO_MINIBATCH=512                         # steps | assumed | M4 | 16 minibatches per pass
PPO_EPOCHS=10                             # - | assumed | M4 | passes over each batch (SB3 default)
PPO_CLIP=0.2                              # - | assumed | M4 | policy-ratio clip (SB3 default)
PPO_TARGET_KL=0.02                        # - | assumed | M4 | caps each update: its passes stop once the policy has moved this far (approx KL; SB3 stops at 1.5x). Added 2026-10-12: without it the first night's updates grew to 0.05-0.4 and the seeds forgot how to land (docs/env_variables.md)
PPO_VALUE_COEF=0.5                        # - | assumed | M4 | value-loss weight (SB3 default)
PPO_MAX_GRAD_NORM=0.5                     # - | assumed | M4 | gradient-norm clip (SB3 default)
PPO_NET_ARCH=256,256                      # units | assumed | M4 | hidden layers (tanh) of the policy, and of the separate value network
PPO_INIT_STD=0.1                          # - | assumed | M4 | starting exploration noise on each action; with 0.3 the pilots tumbled and hovered more (docs/env_variables.md)
PPO_INIT_CUT_PROB=0.0005                  # - | assumed | M4 | chance per control step that the untrained agent cuts the engines (D23); it starts with the valves at hover trim

# ---------------------------------------------------------------- PARKED: not read by the code yet --
# Re-enable a fact by removing the leading '# ' and adding its field (and group) to lander/config.py.
# M5 (evaluation benchmark)
# VIKING_REQ_STABILITY_PROB=0.997         # - | published | S5 Table 1 | Viking's landing-gear stability
