# =====================================================================================================
#  Mars Lander RL - every physical fact and simulation setting the code uses, one per line.
#
#  Format:    KEY=value          # unit | status | source | note
#    status   published = printed in a source (page / figure / table given in `source`)
#             derived   = computed from published numbers (how is in `note`)
#             assumed   = our estimate or design choice - verify or change it
#    Lists are comma-separated (one value per engine / leg / ...).
#    lander/config.py refuses to start if a line is missing, unknown, or has no status/source.
#    docs/env_variables.md explains every variable and why it is kept.
#
#  Change a value: edit it here, or override without editing:
#    PowerShell:  $env:LANDER_VIKING_ENGINE_T90_S = "0.1"    (env var  LANDER_<KEY>)
#    any script:  --set VIKING_ENGINE_T90_S=0.1              (CLI)
#  Overrides are marked status "override" and recorded in every episode log.
#  This file holds no secrets; keep it that way (VS Code also loads .env into the environment).
#
#  Geometry frame (same as NASA TN D-7959, S4 Fig 3): origin on the lander's centre line at the
#  footpad contact plane, +Z up the thrust axis, leg 1 on +Y, azimuths measured from +X toward +Y.
#  Simplified vehicle (brief D15): rigid legs, CG fixed on the centre line, no roll jets.
#
#  Sources (local copies of S3/S4/S5: python -m scripts.fetch_sources -> docs/sources/)
#   S2  Viking 1 Lander (NASA NSSDCA) ............ https://nssdc.gsfc.nasa.gov/nmc/spacecraft/display.action?id=1975-075C
#   S3  NASA RP-1027 Viking '75 design & test .... https://ntrs.nasa.gov/api/citations/19810001592/downloads/19810001592.pdf
#   S4  NASA TN D-7959 touchdown Monte Carlo ..... https://ntrs.nasa.gov/api/citations/19750023452/downloads/19750023452.pdf
#   S5  Pohlen et al., Viking landing gear ....... https://ntrs.nasa.gov/api/citations/19760021205/downloads/19760021205.pdf
#   S7  Dawson et al., MSL throttling engine ..... AIAA 2007-5481
#   S8  Viking engine cutaway, 18-nozzle loss .... https://www.researchgate.net/figure/king-Lander-Engine-Cutaway-View-Rocket-Research-Primex-Aerospace_fig4_232617757
#   S9  Aerojet Mars lander propulsion ........... IAC-10.C4.1.7
#   S11 NASA Mars fact sheet ..................... https://nssdc.gsfc.nasa.gov/planetary/factsheet/marsfact.html
#   brief CLAUDE.md design brief (numerical choices made in the design discussion)
#  Page numbers ("p96") are PDF page numbers of the local copies.
# =====================================================================================================

# ---------------------------------------------------------------- terminal descent engines -----------
VIKING_ENGINE_THRUST_MIN_N=276            # N | published | S2,S9 | per engine at valve setting 0 (10:1 throttle); only the engines-off command gives zero thrust
VIKING_ENGINE_THRUST_MAX_N=2667           # N | published | S2,S9 | per engine at valve setting 1; S3's blowdown thrust decay not modelled (D13)
VIKING_ENGINE_ISP_S=195                   # s | derived | S7,S8 | MSL engine measured 204-223 s, minus ~9% loss of Viking's 18-nozzle design
VIKING_ENGINE_X_M=0.835,-0.835,0.0        # m | published | S4 Fig 6a | engines 1,2,3; measured from the centre line
VIKING_ENGINE_Y_M=0.482,0.482,-0.989      # m | published | S4 Fig 6a | S3 Fig 74 (as flown) lists 0.836 / 0.483 / 0.965 m
VIKING_ENGINE_T90_S=0.053                 # s | derived | S4 Fig 6b,S7 | time to 90 % of any thrust change: Viking's shutdown tail-off digitised as first order (tau ~23 ms); used for throttle-up too (assumed; MSL valve 50 ms, S7)
VIKING_ENGINE_MISALIGN_DEG=0.044          # deg | assumed | S7 /c| thrust-axis error, random direction each episode; proxy: MSL engine measured value (Viking spec +-1.0 deg geometric, S3 p97)

# ---------------------------------------------------------------- mass and inertia -------------------
VIKING_MASS_DRY_KG=573.1                  # kg | derived | S2,S3 p141 | 657 kg at engine ignition (S2) minus 83.9 kg terminal-descent propellant (S3); mass = dry + propellant left
VIKING_MASS_START_PROPELLANT_KG=60        # kg | assumed | - | propellant at the start of an episode (200-500 m up); a careful landing from 500 m at 30 m/s needs ~45-55 kg; check with the M3 controller
VIKING_MASS_IXX_KGM2=162.7                # kg*m2 | published | S4 Fig 3 | principal, about body axes through the CG, at touchdown mass (120 slug*ft2); held constant
VIKING_MASS_IYY_KGM2=216.9                # kg*m2 | published | S4 Fig 3 | (160 slug*ft2)
VIKING_MASS_IZZ_KGM2=298.3                # kg*m2 | published | S4 Fig 3 | (220 slug*ft2)
VIKING_MASS_CG_Z_M=0.7904                 # m | published | S4 Fig 3 | CG height above the footpad plane (= 0.566 x footpad radius, S4 p5); CG on the centre line (D15)

# ---------------------------------------------------------------- landing legs (rigid) --------------
VIKING_LEG_AZIMUTH_DEG=90,-30,210         # deg | published | S4 Fig 3 | legs 1,2,3
VIKING_LEG_FOOTPAD_RADIUS_M=1.397         # m | published | S4 Fig 3,S5 Fig 8 | 55.00 in from the centre line
VIKING_LEG_FOOTPAD_Z_M=0.03175            # m | published | S4 Fig 3,S5 Fig 8 | footpad junction above the contact plane (1.25 in) = contact sphere radius

# ---------------------------------------------------------------- aerodynamics ----------------------
VIKING_AERO_CDA_AXIAL_M2=1.80             # m2 | assumed | S2 | drag coefficient x area for flow along Z: Cd 1.05 (bluff body, assumed) x 1.71 m2 hexagon plan area (S2 sides 1.09 / 0.56 m)
VIKING_AERO_CDA_LATERAL_M2=2.01           # m2 | derived | S4 Table II,S3 p98,S11 | calibrated: S4's 3-sigma lateral aero force 57.58 N at the 99 % design wind 51 m/s (S3 p98) in 0.022 kg/m3 air (S11: 0.016 + 0.006)

# ---------------------------------------------------------------- radars (altimeter + Doppler) ------
VIKING_RADAR_PERIOD_S=0.2                 # s | published | S3 p93 | both radars sampled every 200 ms (sample-and-hold); antennas at the centre of the underside
VIKING_RADAR_ALT_MIN_RANGE_M=41           # m | published | S3 p103,p109 | altimeter readings below 41 m were ignored (false lock on lander structure)
VIKING_RADAR_ALT_ERR_FRAC=0.045           # - | published | S3 p109 | accuracy 4.5 % + 1.5 m; treated as 3 sigma (assumed)
VIKING_RADAR_ALT_ERR_M=1.5                # m | published | S3 p109 |
VIKING_RADAR_DOPPLER_SPLAY_DEG=21.5       # deg | published | S3 p112 | each of the 4 beams is 21.5 deg from the -Z axis
VIKING_RADAR_DOPPLER_CLOCK_DEG=45         # deg | published | S3 Fig 60 | beams rotated 45 deg from the pitch/yaw axes
VIKING_RADAR_DOPPLER_MIN_SPEED_MPS=1      # m/s | published | S3 p112 | a beam needs >= 1 m/s closing speed to lock; any 3 locked beams give the velocity
VIKING_RADAR_DOPPLER_ERR_FRAC=0.015       # - | published | S3 p112 | accuracy 1.5 % or 0.3 m/s, whichever is greater; treated as 3 sigma (assumed)
VIKING_RADAR_DOPPLER_ERR_MPS=0.3          # m/s | published | S3 p112 |

# ---------------------------------------------------------------- landing requirements (brief section 7)
VIKING_REQ_VERTICAL_SPEED_MPS=3.34        # m/s | derived | S5 Table 1 | 2.44 + 0.9 m/s; a faster first contact breaks a leg
VIKING_REQ_HORIZONTAL_SPEED_MPS=1.22      # m/s | published | S5 Table 1 | a faster first contact breaks a leg
VIKING_REQ_SETTLE_KE_FRAC=0.005           # - | published | S4 p9 | settled when kinetic energy < 0.5 % of impact KE

# ---------------------------------------------------------------- reference values (validation) -----
VIKING_REF_TIPOVER_P_45DEG=0.85           # - | published | S4 p15 | probability of tip-over landing on a 45 deg slope (Viking's crushable legs)

# ---------------------------------------------------------------- Mars ------------------------------
MARS_GRAVITY_MPS2=3.71                    # m/s2 | published | S11 | mean surface gravity (equatorial 3.69); S3 p13 design value 3.7
MARS_AIR_DENSITY_KGPM3=0.016              # kg/m3 | published | S11 | surface value, used at every height (it changes < 5 % over 500 m)
MARS_WIND_STORM_MPS=17,30                 # m/s | published | S11 | dust-storm wind range; calm episodes have no wind (2-10 m/s moves the lander < 0.08 m/s in 30 s)

MARS_TERRAIN_SLOPE_DEG=0                  # deg | assumed | - | default flat ground (M2 samples slopes)
MARS_TERRAIN_SLOPE_DIRECTION_DEG=0        # deg | assumed | - | downhill direction, from +X toward +Y
MARS_TERRAIN_FRICTION=0.6                 # - | assumed | S4,S5 | default footpad friction, middle of the published 0.2-1.0 range

# ---------------------------------------------------------------- simulation numerics ---------------
SIM_PHYSICS_DT_S=0.002                    # s | assumed | brief | physics step; brief section 6: <= 2 ms
SIM_CONTROL_HZ=25                         # Hz | assumed | brief,S3 p105 | 40 ms zero-order hold = Viking navigator / outer-loop period
SIM_CONTACT_TIMECONST_S=0.005             # s | assumed | - | MuJoCo soft-contact time constant (keep >= 2 x physics step); with rigid legs it shapes the impact
SIM_SENSOR_NOISE_SCALE=1.0                # - | assumed | brief | 1 = Viking's published radar errors (decided 2026-10-05); 0 = perfect readings (tests)

# ---------------------------------------------------------------- PARKED: not read by the code yet --
# Re-enable a fact by removing the leading '# ' and adding its field (and group) to lander/config.py.
# M3 (classical controller): Viking's final-phase guidance
# VIKING_SEQ_TERMINAL_SPEED_MPS=2.44      # m/s | published | S3 p104 | constant-velocity final descent
# VIKING_SEQ_TERMINAL_ALT_M=16.8          # m | published | S3 p104 | start of the constant-velocity phase (brief / S10: ~12 m)
# VIKING_SEQ_AXIAL_THROTTLE_LIMIT=0.84    # - | published | S3 p99 | average valve limit for the axial-velocity loop
# M2 (open decision O3: touchdown attitude limits)
# VIKING_REQ_TILT_DEG=5                   # deg | published | S3 Table 8 | touchdown attitude 0 +- 5 deg
# VIKING_REQ_RATE_PITCHYAW_DPS=7          # deg/s | published | S3 Table 8 |
# M2 (terrain sampling)
# MARS_TERRAIN_SLOPE_P90_DEG=11.7         # deg | published | S4 p15,Table II | slopes exponential, 90 % below 11.7 deg
# MARS_TERRAIN_FRICTION_RANGE=0.2,1.0     # - | published | S4 p8,S5 Table 1 | 0.2 critical for clearance, 1.0 for stability
# M5 (evaluation benchmark)
# VIKING_REQ_STABILITY_PROB=0.997         # - | published | S5 Table 1 | Viking's landing-gear stability
